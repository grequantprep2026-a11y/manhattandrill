rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read/write their own profile
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Allow users to read/write their own question attempts
    match /questionAttempts/{uid}/attempts/{questionId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Allow users to read/write their own similar-question attempts
    match /questionAttempts/{uid}/similarAttempts/{questionId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Allow users to read/write their own topic progress
    match /topicProgress/{uid}/topics/{topicId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Feedback submissions: authenticated users can create their own requests
    match /featureRequests/{requestId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Community stats: everyone can read, authenticated users can update stats
    match /questionStats/{questionId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
      
      // Likedby: any authenticated user can manage their own like doc
      match /likedBy/{userId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Votedby: any authenticated user can manage their own vote doc
      match /votedBy/{userId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
